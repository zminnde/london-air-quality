@Article{daneshyazdi2020,
    AUTHOR = {Danesh Yazdi, Mahdieh and Kuang, Zheng and Dimakopoulou, Konstantina and Barratt, Benjamin and Suel, Esra and Amini, Heresh and Lyapustin, Alexei and Katsouyanni, Klea and Schwartz, Joel},
    TITLE = {Predicting Fine Particulate Matter (PM2.5) in the Greater London Area: An Ensemble Approach using Machine Learning Methods},
    JOURNAL = {Remote Sensing},
    VOLUME = {12},
    YEAR = {2020},
    NUMBER = {6},
    ARTICLE-NUMBER = {914},
    URL = {https://www.mdpi.com/2072-4292/12/6/914},
    ISSN = {2072-4292},
    ABSTRACT = {Estimating air pollution exposure has long been a challenge for environmental health researchers. Technological advances and novel machine learning methods have allowed us to increase the geographic range and accuracy of exposure models, making them a valuable tool in conducting health studies and identifying hotspots of pollution. Here, we have created a prediction model for daily PM2.5 levels in the Greater London area from 1st January 2005 to 31st December 2013 using an ensemble machine learning approach incorporating satellite aerosol optical depth (AOD), land use, and meteorological data. The predictions were made on a 1 km × 1 km scale over 3960 grid cells. The ensemble included predictions from three different machine learners: a random forest (RF), a gradient boosting machine (GBM), and a k-nearest neighbor (KNN) approach. Our ensemble model performed very well, with a ten-fold cross-validated R2 of 0.828. Of the three machine learners, the random forest outperformed the GBM and KNN. Our model was particularly adept at predicting day-to-day changes in PM2.5 levels with an out-of-sample temporal R2 of 0.882. However, its ability to predict spatial variability was weaker, with a R2 of 0.396. We believe this to be due to the smaller spatial variation in pollutant levels in this area.},
    DOI = {10.3390/rs12060914},
    file = {./dokumentai/straipsniai/Predicting Fine Particulate Matter.pdf},
}

@article{pandya2024,
    abstract = {Air quality in metropolitan areas has deteriorated due to growing urbanisation and industrialisation, leading to severe health and significant economic consequences. This paper discusses the particulate matter PM2.5 and PM10 forecasting performances of three Machine Learning algorithms: SVM, Random Forest, and k-NN. In our comparisons, we attempt to account for the often overlooked influence of the training dataset on model performance, which significantly influences the accuracy of insights derived from a model. The scope of this study helps determine the numerous international research works to help better analyse the algorithms employed and their execution to generate insights into particulate matter concentrations, which assists in shaping future climate change policies. Our analyses show that SVMs can work with dimensional data, and Random Forests can provide multi-faceted, non-linear regression and classification with higher R2 values than SVM for some datasets. K-NN is frequently applied for preprocessing (data imputation). Furthermore, it has been observed that hybrid models outperform the approaches leveraging independent algorithms.},
    author = {Pandya, Aum and Nanavaty, Rudraksh and Pipariya, Kishan and Shah, Manan},
    date-added = {2026-08-27 13:31:56 +0300},
    date-modified = {2026-08-27 13:31:56 +0300},
    doi = {10.1007/s11831-023-09994-x},
    id = {Pandya2024},
    journal = {Archives of Computational Methods in Engineering},
    number = {2},
    pages = {595--614},
    title = {A Comparative and Systematic Study of Machine Learning (ML) Approaches for Particulate Matter (PM) Prediction},
    url = {https://doi.org/10.1007/s11831-023-09994-x},
    volume = {31},
    year = {2024},
    bdsk-url-1 = {https://doi.org/10.1007/s11831-023-09994-x},
    file = {./dokumentai/straipsniai/A Comparative and Systematic Study of Machine Learning (ML) Approaches for PM.pdf}
}

