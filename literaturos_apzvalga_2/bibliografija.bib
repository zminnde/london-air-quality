@article{martinez2019,
    abstract = {In this paper a methodology for applying k-nearest neighbor regression on a time forecasting context is developed. The goal is to devise an automatic tool, i.e., a tool that can work without human intervention; furthermore, the methodology should be effective and efficient, so that it can be applied to accurately forecast a great number of time. In order to be incorporated into our methodology, several modeling and preprocessing techniques are analyzed and assessed using the N3 competition data set. One interesting feature of the proposed methodology is that it resolves the selection of important modeling parameters, such as k or the input variables, combining several models with different parameters. In spite of the simplicity of k-NN regression, our methodology seems to be quite effective.},
    author = {Mart{\'\i}nez, Francisco and Fr{\'\i}as, Mar{\'\i}a Pilar and P{\'e}rez, Mar{\'\i}a Dolores and Rivera, Antonio Jes{\'u}s},
    date-added = {2026-08-27 22:18:46 +0300},
